PORT=8080

# Signs login sessions (JWT). Required for sessions to survive a restart -
# if unset, a random secret is generated at boot and every restart logs
# everyone out. Generate one with: openssl rand -hex 32
JWT_SECRET=

# LLM providers - Gemini is tried first, OpenAI is the fallback. Leave empty to use mock data.
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Text-to-speech (ElevenLabs is tried first, falls back to OpenAI TTS, then a silent mock clip)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Stock media / cloud render (optional - fall back to free stock clips / local FFmpeg render)
PEXELS_API_KEY=your_pexels_api_key_here
SHOTSTACK_API_KEY=your_shotstack_api_key_here

# OAuth apps for auto-posting
YOUTUBE_CLIENT_ID=your_youtube_client_id_here
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret_here
TIKTOK_CLIENT_ID=your_tiktok_client_id_here
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret_here
REDIRECT_URI=http://localhost:8080/api/oauth/callback

# Postgres (optional). Leave POSTGRES_HOST empty to use a local SQLite file instead.
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_USER=makina
POSTGRES_PASSWORD=makinadark
POSTGRES_DB=makinadark

# Cloudflare R2 (optional). Leave R2_BUCKET empty to store generated
# images/audio/video on local disk under ./media instead.
# Create the bucket + an API token (Account > R2 > Manage API tokens) in the
# Cloudflare dashboard, and enable a public URL for the bucket (r2.dev URL or
# a custom domain) for R2_PUBLIC_BASE_URL.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# Copy this file to .env and fill in real values. .env is gitignored and must
# never be committed - rotate any key that was ever written to a tracked file.
