# Copy this file to backend/.env and fill in real values. docker-compose.yml
# loads backend/.env (and/or a .env next to docker-compose.yml - that's what
# EasyPanel writes from its Environment tab) straight into the backend
# container. .env files are gitignored and must never be committed - rotate
# any key that was ever written to a tracked file.

PORT=8080

# Signs login sessions (JWT) and OAuth state. Required for sessions to
# survive a restart - if unset, a random secret is generated at boot and
# every restart logs everyone out. Generate one with: openssl rand -hex 32
JWT_SECRET=

# First account, created only when the database has no users yet. If
# ADMIN_PASSWORD is empty a random one is generated and printed in the logs.
ADMIN_EMAIL=admin@makinadark.com
ADMIN_PASSWORD=
# Every account runs on the API keys below - keep sign-up closed on a public URL.
ALLOW_REGISTRATION=false

# LLM providers for scripts/branding, tried in this order: Groq -> Gemini ->
# Claude -> OpenAI. At least one is required.
GROQ_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Daily free-tier request quota of the Gemini key, shown on the cost dashboard.
GEMINI_FREE_TIER_DAILY_LIMIT=20

# Images. Logo, channel banner and video thumbnails use OpenAI (gpt-image)
# first, then Gemini. Scene images use Pexels photos, then Pollinations, then Gemini.
# OPENAI_IMAGE_QUALITY=high   # low | medium | high (default: high for logo/banner, medium for thumbnails)
# OPENAI_IMAGE_MODEL=gpt-image-1.5
POLLINATIONS_API_KEY=

# Text-to-speech: ElevenLabs -> OpenAI TTS -> free Google TTS fallback.
ELEVENLABS_API_KEY=

# Stock media / cloud render (optional - fall back to free stock clips / local FFmpeg render)
PEXELS_API_KEY=
SHOTSTACK_API_KEY=

# Length cap (seconds) of the 9:16 version that is posted to TikTok. 0 = full length.
SHORTS_MAX_SECONDS=60

# OAuth apps for auto-posting. REDIRECT_URI must be registered in the Google /
# TikTok developer consoles. Behind the bundled frontend it's
# <frontend URL>/api/oauth/callback (e.g. http://localhost:3000/api/oauth/callback
# or https://your-domain/api/oauth/callback).
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
REDIRECT_URI=http://localhost:3000/api/oauth/callback

# Postgres (optional outside Docker). Leave POSTGRES_HOST empty to use a local
# SQLite file instead. docker-compose.yml always points the backend at its own
# postgres service.
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_USER=makina
POSTGRES_PASSWORD=makinadark
POSTGRES_DB=makinadark

# Cloudflare R2 (optional). Leave R2_BUCKET empty to store generated
# images/audio/video on local disk under ./media instead.
# Create the bucket + an API token (Account > R2 > Manage API tokens) in the
# Cloudflare dashboard, and enable a public URL for the bucket (r2.dev URL or
# a custom domain) for R2_PUBLIC_BASE_URL.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# Optional
# TZ=America/Sao_Paulo          # wall clock for the auto-pilot's preferred post hour
# DB_LOG_LEVEL=warn             # info logs every SQL query
# CORS_ORIGINS=http://localhost:5173   # only when NOT using the bundled nginx proxy
