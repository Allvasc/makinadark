server {
    listen 80;
    server_name _;

    # Same-origin proxy to the backend container (see App.vue's API_BASE/
    # MEDIA_BASE) - the browser only ever talks to this one host:port, so it
    # works behind any domain/HTTPS reverse proxy (EasyPanel, etc.) with no
    # CORS or mixed-content configuration needed.
    #
    # BACKEND_HOST/BACKEND_PORT are substituted at container start (this file
    # ships as /etc/nginx/templates/default.conf.template - the official
    # nginx image runs envsubst on it before boot, see Dockerfile). Defaults
    # to "backend"/8080, matching docker-compose.yml's service name; override
    # BACKEND_HOST when the backend isn't reachable under that exact name
    # (e.g. EasyPanel, where a project named "ytd" makes every internal
    # hostname "ytd_<service>").

    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    location /api/ {
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT}/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Channel creation (LLM + two high-quality images) can take minutes.
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }

    location /media/ {
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT}/media/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # Pass Range requests straight through so <video> can seek, and stream
        # large renders instead of buffering whole files to disk first.
        proxy_set_header Range $http_range;
        proxy_set_header If-Range $http_if_range;
        proxy_buffering off;
        proxy_read_timeout 600s;
    }

    # Vite emits content-hashed file names under /assets - safe to cache forever.
    location /assets/ {
        root /usr/share/nginx/html;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location / {
        root /usr/share/nginx/html;
        index index.html;
        # index.html must never be cached: it's what points at the current
        # hashed bundle, so a cached copy keeps loading a deleted/old build.
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }

    error_page 500 502 503 504 /50x.html;
    location = /50x.html {
        root /usr/share/nginx/html;
    }
}
